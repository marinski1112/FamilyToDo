{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "familytodo",
  "main": "src/index-wave117.ts",
  "compatibility_date": "2026-08-24",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/",
      "/index.php",
      "/api/*",
      "/oauth/*",
      "/app/api/*",
      "/__cf/*",
      "/login",
      "/login.php",
      "/liff"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "familytodo",
      "database_id": "9d9d6de8-ff45-4dd6-9fec-0de70ee1d093",
      "migrations_dir": "./migrations"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "vars": {
    "APP_NAME": "家族TODO LINE",
    "APP_URL": "https://familytodo.marinski1112.workers.dev",
    "APP_TIMEZONE": "Asia/Tokyo",
    "NOTIFY_MODE": "scheduled",
    "ENVIRONMENT": "staging"
  },
  "triggers": {
    "crons": ["*/5 * * * *", "3,13,23,33,43,53 * * * *"]
  },
  "observability": {
    "enabled": true
  }
}
