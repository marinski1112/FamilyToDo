{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "familytodo-cloudflare-staging",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-24",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/app/api/*",
      "/__cf/*",
      "/login",
      "/login.php"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "familytodo",
      "database_id": "9d9d6de8-ff45-4dd6-9fec-0de70ee1d093",
      "migrations_dir": "./migrations"
    }
  ],
  "vars": {
    "APP_NAME": "家族TODO LINE",
    "APP_URL": "https://family.tsuchy.jp",
    "APP_TIMEZONE": "Asia/Tokyo",
    "NOTIFY_MODE": "manual",
    "ENVIRONMENT": "staging"
  },
  "triggers": {
    "crons": ["*/15 * * * *"]
  },
  "observability": {
    "enabled": true
  }
}
