{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "familytodo",
  "main": "src/calendar-perf-worker.ts",
  "compatibility_date": "2026-08-24",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/",
      "/index.php",
      "/api/*",
      "/oauth/*",
      "/app/calendar.php",
      "/app/api/*",
      "/__cf/*",
      "/login",
      "/login.php",
      "/liff",
      "/liff/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "familytodo",
      "database_id": "9d9d6de8-ff45-4dd6-9fec-0de70ee1d093",
      "migrations_dir": "./migrations"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "vars": {
    "APP_NAME": "家族TODO LINE",
    "APP_URL": "https://familytodo.marinski1112.workers.dev",
    "APP_TIMEZONE": "Asia/Tokyo",
    "NOTIFY_MODE": "scheduled",
    "ENVIRONMENT": "staging",
    "CALENDAR_PERF_DIAGNOSTICS": "1",
    "GOOGLE_HOME_CLIENT_ID": "Family_ToDo",
    "GOOGLE_HOME_PROJECT_ID": "family-todo-home",
    "FAMILY_AI_PROVIDER": "GEMINI",
    "GEMINI_MODEL": "gemini-3.1-flash-lite",
    "WORKERS_AI_MODEL": "@cf/meta/llama-3.1-8b-instruct-fast",
    "GOOGLE_CALENDAR_REDIRECT_URI": "https://familytodo.marinski1112.workers.dev/oauth/google-calendar/callback",
    "GOOGLE_TASKS_REDIRECT_URI": "https://familytodo.marinski1112.workers.dev/oauth/google-tasks/callback",
    "LINE_LOGIN_GOOGLE_HOME_REDIRECT_URI": "https://familytodo.marinski1112.workers.dev/oauth/line/google-home/callback"
  },
  "triggers": {
    "crons": [
      "*/5 * * * *",
      "3,8,13,18,23,28,33,38,43,48,53,58 * * * *",
      "7,37 * * * *"
    ]
  },
  "observability": {
    "enabled": true
  },
  "keep_vars": true
}
