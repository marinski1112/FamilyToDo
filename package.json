{
  "name": "familytodo-cloudflare",
  "version": "12.86.0-wave67",
  "private": true,
  "description": "Family TODO LINE - Cloudflare Workers migration foundation",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler d1 migrations apply DB --remote && wrangler deploy",
    "typecheck": "wrangler types && tsc --noEmit",
    "check:calendar-js": "node --check public/assets/calendar.js",
    "check:recurring-js": "node --check public/assets/recurring.js",
    "check:browser-js": "node --check public/assets/calendar.js && node --check public/assets/recurring.js"
  },
  "dependencies": {},
  "devDependencies": {
    "typescript": "^5.9.2",
    "wrangler": "^4.34.0"
  }
}
