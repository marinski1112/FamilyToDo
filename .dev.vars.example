# Copy to .dev.vars for local development. Never commit real values.
LINE_CHANNEL_SECRET="replace-me"
LINE_CHANNEL_ID="replace-me"
LINE_LIFF_ID="replace-me"
LINE_ACCESS_TOKEN="replace-me"
APP_SECRET="replace-with-a-long-random-secret"
NOTIFY_SECRET="replace-me"

# Generate with: npm run generate:vapid
VAPID_PUBLIC_KEY="replace-me"
VAPID_PRIVATE_KEY="replace-me"
VAPID_SUBJECT="mailto:you@example.com"

# Google Home Cloud-to-cloud (Calendar OAuthとは別credential)
GOOGLE_HOME_CLIENT_ID=
GOOGLE_HOME_CLIENT_SECRET=
GOOGLE_HOME_PROJECT_ID=
